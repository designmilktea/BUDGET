rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/budgetApps/daily {
      allow read: if owner(uid);
      allow create: if owner(uid) && validProfile() && request.resource.data.revision == 1;
      allow update: if owner(uid) && validProfile()
        && request.resource.data.revision == resource.data.revision + 1;
      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasAll(['revision', 'payload', 'updatedAt'])
          && d.keys().hasOnly(['revision', 'payload', 'updatedAt'])
          && d.revision is int && d.revision > 0
          && d.payload is string && d.payload.size() <= 900000
          && d.updatedAt == request.time;
      }
    }
    match /users/{uid}/budgetHistory/{day} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasAll(['payload'])
        && request.resource.data.keys().hasOnly(['payload'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 900000;
    }
    function signedIn() { return request.auth != null; }
    function budgetOwner(id) { return signedIn() && get(/databases/$(database)/documents/budgets/$(id)).data.ownerUid == request.auth.uid; }
    function budgetMember(id) { return signedIn() && exists(/databases/$(database)/documents/budgets/$(id)/members/$(request.auth.uid)); }
    function budgetMemberAfter(id) { return signedIn() && existsAfter(/databases/$(database)/documents/budgets/$(id)/members/$(request.auth.uid)); }
    function invitedEmail(email) { return signedIn() && request.auth.token.email_verified == true && request.auth.token.email.lower() == email; }
    function validPayload() { return request.resource.data.payload is string && request.resource.data.payload.size() <= 900000; }

    match /budgets/{id} {
      allow read: if budgetMember(id);
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['ownerUid', 'title', 'timezone', 'revision', 'nextColor', 'payload', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['ownerUid', 'title', 'timezone', 'revision', 'nextColor', 'payload', 'updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title == 'Shared budget'
        && request.resource.data.timezone == 'Asia/Tokyo'
        && request.resource.data.revision == 1 && request.resource.data.nextColor == 1
        && validPayload() && request.resource.data.updatedAt == request.time;
      allow update: if budgetMember(id) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payload', 'revision', 'updatedAt'])
          && validPayload() && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.updatedAt == request.time)
        || (budgetOwner(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextColor'])
          && request.resource.data.nextColor == resource.data.nextColor + 1)
      );
    }
    match /budgets/{id}/members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || budgetMember(id));
      function validMember() {
        let d = request.resource.data;
        return d.keys().hasAll(['uid', 'name', 'email', 'color', 'inviteId', 'joinedAt'])
          && d.keys().hasOnly(['uid', 'name', 'email', 'color', 'inviteId', 'joinedAt'])
          && d.uid == uid && d.name is string && d.name.size() <= 200
          && d.email == request.auth.token.email.lower()
          && d.color is int && d.color >= 0 && d.color < 360
          && d.joinedAt == request.time;
      }
      function acceptingInvite() {
        let invitation = get(/databases/$(database)/documents/budgetInvites/$(request.resource.data.inviteId)).data;
        let after = getAfter(/databases/$(database)/documents/budgetInvites/$(request.resource.data.inviteId)).data;
        return invitation.budgetId == id && invitation.status == 'pending'
          && invitedEmail(invitation.email) && invitation.expiresAt > request.time
          && request.resource.data.color == invitation.color
          && after.status == 'accepted' && after.acceptedBy == uid;
      }
      allow create: if signedIn() && request.auth.uid == uid && validMember() && (
        (getAfter(/databases/$(database)/documents/budgets/$(id)).data.ownerUid == uid
          && request.resource.data.inviteId == '' && request.resource.data.color == 36)
        || acceptingInvite()
      );
      allow delete: if signedIn()
        && uid != get(/databases/$(database)/documents/budgets/$(id)).data.ownerUid
        && (request.auth.uid == uid || budgetOwner(id));
    }
    match /users/{uid}/sharedBudgets/{id} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && existsAfter(/databases/$(database)/documents/budgets/$(id)/members/$(uid))
        && request.resource.data.keys().hasAll(['title', 'ownerUid'])
        && request.resource.data.keys().hasOnly(['title', 'ownerUid'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 300
        && request.resource.data.ownerUid == getAfter(/databases/$(database)/documents/budgets/$(id)).data.ownerUid;
      allow delete: if signedIn() && (request.auth.uid == uid || budgetOwner(id));
    }
    match /budgets/{id}/days/{day} {
      allow read: if budgetMember(id);
      allow create: if budgetMember(id) && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['payload']) && validPayload();
      // Historical records are read-only once archived.
    }
    match /budgets/{id}/events/{event} {
      allow read: if budgetMember(id);
      allow create: if (budgetMember(id) || budgetMemberAfter(id))
        && request.resource.data.keys().hasAll(['day', 'actorUid', 'actorName', 'kind', 'message', 'createdAt'])
        && request.resource.data.keys().hasOnly(['day', 'actorUid', 'actorName', 'kind', 'message', 'createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorName is string && request.resource.data.actorName.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000
        && request.resource.data.kind in ['add', 'select', 'remove', 'checkout', 'rename', 'deletePurchase', 'budget', 'invite', 'membership']
        && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.createdAt == request.time;
    }
    match /budgetInvites/{inviteId} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || invitedEmail(resource.data.email));
      allow create: if signedIn() && budgetOwner(request.resource.data.budgetId)
        && request.resource.data.keys().hasAll(['budgetId', 'title', 'ownerUid', 'ownerName', 'email', 'color', 'status', 'createdAt', 'expiresAt'])
        && request.resource.data.keys().hasOnly(['budgetId', 'title', 'ownerUid', 'ownerName', 'email', 'color', 'status', 'createdAt', 'expiresAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title == get(/databases/$(database)/documents/budgets/$(request.resource.data.budgetId)).data.title
        && request.resource.data.ownerName is string && request.resource.data.ownerName.size() <= 200
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.color is int && request.resource.data.color >= 0 && request.resource.data.color < 360
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(14, 'd');
      allow update: if signedIn() && resource.data.status == 'pending' && (
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancelled')
        || (invitedEmail(resource.data.email) && resource.data.expiresAt > request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt'])
          && request.resource.data.status == 'accepted' && request.resource.data.acceptedBy == request.auth.uid
          && request.resource.data.acceptedAt == request.time
          && getAfter(/databases/$(database)/documents/budgets/$(resource.data.budgetId)/members/$(request.auth.uid)).data.inviteId == inviteId)
      );
    }
  }
}
