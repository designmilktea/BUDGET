rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/budgetApps/daily {
      allow read: if owner(uid);
      allow create: if owner(uid) && validProfile() && request.resource.data.revision == 1;
      allow update: if owner(uid) && validProfile()
        && request.resource.data.revision == resource.data.revision + 1;
      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasAll(['revision', 'payload', 'updatedAt'])
          && d.keys().hasOnly(['revision', 'payload', 'updatedAt'])
          && d.revision is int && d.revision > 0
          && d.payload is string && d.payload.size() <= 900000
          && d.updatedAt == request.time;
      }
    }
    match /users/{uid}/budgetHistory/{day} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasAll(['payload'])
        && request.resource.data.keys().hasOnly(['payload'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 900000;
    }
    // Other paths (including the previous app schema) are denied by default.
  }
}
