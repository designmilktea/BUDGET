rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validBudget() {
      return request.resource.data.keys().hasAll(['amount'])
        && request.resource.data.keys().hasOnly(['amount'])
        && request.resource.data.amount is int
        && request.resource.data.amount >= 0
        && request.resource.data.amount <= 1000000000;
    }
    function validEntry() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'amount', 'kind', 'selected', 'purchaseDate', 'purchasedAt', 'createdAt', 'version'])
        && d.keys().hasOnly(['name', 'amount', 'kind', 'selected', 'purchaseDate', 'purchasedAt', 'createdAt', 'version'])
        && d.name is string && d.name.size() <= 100
        && d.amount is int && d.amount > 0 && d.amount <= 1000000000
        && d.kind in ['cart', 'purchase', 'removed']
        && d.selected is bool
        && d.purchaseDate is string
        && d.purchasedAt is int && d.purchasedAt >= 0
        && d.createdAt is int && d.createdAt >= 0
        && d.version is int && d.version > 0
        && (d.kind != 'purchase' || (d.purchaseDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.purchasedAt > 0 && d.selected == false))
        && (d.kind != 'cart' || (d.purchaseDate == '' && d.purchasedAt == 0));
    }
    match /users/{uid}/settings/budget {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validBudget();
    }
    match /users/{uid}/days/{day} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && validBudget();
    }
    match /users/{uid}/entries/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validEntry() && request.resource.data.version == 1;
      allow update: if owner(uid) && validEntry()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.version == resource.data.version + 1;
    }
  }
}
